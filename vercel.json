{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/hermes",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/vm",
      "destination": "/api/vm"
    },
    {
      "source": "/article/:id",
      "destination": "/api/article-og?id=:id"
    },
    {
      "source": "/((?!assets/|api/|generated-articles\\.json|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}

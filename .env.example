# Signal Dispatch environment example.
# Copy only the variables you need into `.env`, `backend/.env`, or your host's env UI.
# Do not commit real secrets.

# ---------------------------------------------------------------------------
# Required backend variables
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Supabase Postgres works well.
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/signal

# ---------------------------------------------------------------------------
# Recommended backend variables
# ---------------------------------------------------------------------------
# Public frontend origin used when the backend builds share/deep-link URLs.
PUBLIC_ARTICLE_BASE_URL=http://127.0.0.1:5175
# Comma-separated frontend origins allowed to call the backend.
CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175

# Model names are only used when their matching provider key is configured.
GEMINI_MODEL=gemini-2.0-flash
CLAIM_MODEL=gpt-4o-mini
SUMMARY_MODEL=gpt-4o-mini
USE_LLM_CLAIMS=false
# Disable these on request-oriented/serverless hosts; leave enabled for a
# persistent demo backend.
SIGNAL_AUTO_INGEST_ON_STARTUP=true
SIGNAL_PERIODIC_RSS=true

# ---------------------------------------------------------------------------
# Frontend variables
# ---------------------------------------------------------------------------
# Backend API origin used by Vite builds and local dev.
VITE_SIGNAL_API_URL=http://127.0.0.1:8000

# Supabase Auth is optional for local demos. Leave blank to avoid sign-in flows.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Optional backend provider keys
# ---------------------------------------------------------------------------
# Gemini is used for polished article prose when available. The backend falls
# back to rule-based writing when this is blank, rate-limited, or failing.
GEMINI_API_KEY=

# OpenAI is used only for optional LLM claim extraction/summaries when enabled.
OPENAI_API_KEY=

# News provider APIs supplement RSS/Bing/GDELT. The app still runs without them.
NEWS_API_KEY=
CURRENTS_API_KEY=
GNEWS_API_KEY=
GUARDIAN_CONTENT_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=

# ---------------------------------------------------------------------------
# Optional ingest configuration
# ---------------------------------------------------------------------------
# Comma-separated custom RSS feeds or query seeds for manual/background scripts.
RSS_FEEDS=
GDELT_QUERIES=

# ---------------------------------------------------------------------------
# Agent / X integration
# ---------------------------------------------------------------------------
# Required only for POST /articles/generate-from-trend and /agents/x/article-reply.
# Generate a long random value and send it as X-Signal-Token or Bearer token.
SIGNAL_API_TOKEN=

# ---------------------------------------------------------------------------
# Script safety switches
# ---------------------------------------------------------------------------
# scripts/run-all.cjs refuses to install Python packages outside a virtualenv
# unless this is set. Prefer creating backend/.venv instead.
SIGNAL_ALLOW_GLOBAL_PIP=0

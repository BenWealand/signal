[Unit]
Description=Signal website article worker (Gemini lane)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=signal-api
Group=signal-api
WorkingDirectory=/opt/signal/backend
EnvironmentFile=/etc/signal-api/signal.env
EnvironmentFile=-/etc/signal-api/gemini.env
# Interrupted-job recovery is lease-based inside the worker loop now. The old
# unconditional ExecStartPre recovery would steal jobs legitimately in flight
# on another website-lane consumer (e.g. the embedded Render worker).
ExecStart=/opt/signal/venv/bin/python -m app.jobs.article_worker --lane website --poll-seconds 1
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
